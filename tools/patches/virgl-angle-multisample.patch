--- /dev/null
+++ b/src/vrend/vrend_angle.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: MIT
+ * Noct: dispatch ANGLE's GLES 3.0 multisample extension without claiming ES 3.1.
+ */
+#ifndef VREND_ANGLE_H
+#define VREND_ANGLE_H
+#include <epoxy/gl.h>
+#ifdef HAVE_EPOXY_EGL_H
+#include <epoxy/egl.h>
+#endif
+
+static inline bool vrend_use_angle_multisample(void)
+{
+#ifdef HAVE_EPOXY_EGL_H
+   return !epoxy_is_desktop_gl() && epoxy_gl_version() < 31 &&
+          epoxy_has_gl_extension("GL_ANGLE_texture_multisample") &&
+          eglGetProcAddress("glTexStorage2DMultisampleANGLE") &&
+          eglGetProcAddress("glGetMultisamplefvANGLE") &&
+          eglGetProcAddress("glSampleMaskiANGLE");
+#else
+   return false;
+#endif
+}
+
+static inline void vrend_tex_storage_2d_multisample(GLenum target, GLsizei samples,
+   GLenum format, GLsizei width, GLsizei height, GLboolean fixed)
+{
+#ifdef HAVE_EPOXY_EGL_H
+   if (vrend_use_angle_multisample()) {
+      typedef void (GLAPIENTRY *Proc)(GLenum, GLsizei, GLenum, GLsizei, GLsizei, GLboolean);
+      ((Proc)eglGetProcAddress("glTexStorage2DMultisampleANGLE"))(target, samples, format, width, height, fixed);
+      return;
+   }
+#endif
+   glTexStorage2DMultisample(target, samples, format, width, height, fixed);
+}
+
+static inline void vrend_get_multisamplefv(GLenum pname, GLuint index, GLfloat *value)
+{
+#ifdef HAVE_EPOXY_EGL_H
+   if (vrend_use_angle_multisample()) {
+      typedef void (GLAPIENTRY *Proc)(GLenum, GLuint, GLfloat *);
+      ((Proc)eglGetProcAddress("glGetMultisamplefvANGLE"))(pname, index, value);
+      return;
+   }
+#endif
+   glGetMultisamplefv(pname, index, value);
+}
+
+static inline void vrend_sample_maski(GLuint index, GLbitfield mask)
+{
+#ifdef HAVE_EPOXY_EGL_H
+   if (vrend_use_angle_multisample()) {
+      typedef void (GLAPIENTRY *Proc)(GLuint, GLbitfield);
+      ((Proc)eglGetProcAddress("glSampleMaskiANGLE"))(index, mask);
+      return;
+   }
+#endif
+   glSampleMaski(index, mask);
+}
+#endif
